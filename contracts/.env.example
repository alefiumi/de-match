# ── De-Match Contracts — Environment Variables ──────────────
# Copy to .env and fill in real values. NEVER commit .env.

# Private key of the deployer wallet (no 0x prefix needed)
DEPLOYER_PRIVATE_KEY=your_private_key_here

# Base Sepolia RPC endpoint
# Free options: https://sepolia.base.org  or Alchemy/Infura
BASE_SEPOLIA_RPC=https://sepolia.base.org

# Basescan API key for contract verification (optional but recommended)
# Get one at: https://basescan.org/myapikey
BASESCAN_API_KEY=your_basescan_api_key_here
